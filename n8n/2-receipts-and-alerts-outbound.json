{
  "name": "WhatsApp: receipts, delivery updates and admin alerts",
  "nodes": [
    {
      "id": "301e2419-6651-4f10-82cb-c80a4f9d6c40",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -80
      ],
      "parameters": {
        "content": "DRAFT - not tested in your n8n yet.\n\nEvery minute: asks the website for messages waiting to go out (customer receipts, delivery updates, and alerts to your admin numbers), sends each one with its approved WhatsApp template through Meta's Cloud API, then tells the website whether it worked. The website guarantees one message per status change per person.\n\nThe website prepares everything: template name, recipient, and the values for {{1}}, {{2}}... (items, total, address, tracking). This workflow just sends.\n\nCredentials: 'Header Auth' x-api-key = N8N_API_SHARED_SECRET (for the 3 website calls); 'Header Auth' Authorization = Bearer YOUR_WHATSAPP_TOKEN (for 'Send via WhatsApp').\nReplace YOUR-SITE.example and YOUR_PHONE_NUMBER_ID.\n\nTemplates (names, texts) are listed in docs/stage6-whatsapp-n8n.md. They must be APPROVED in Meta first.",
        "width": 620,
        "height": 400
      }
    },
    {
      "id": "2fd6a653-24a5-40c8-90ca-e739d30bf838",
      "name": "Every minute",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        540,
        220
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 1
            }
          ]
        }
      }
    },
    {
      "id": "fd192d6b-f023-46d9-bc29-e6282b9a7bf6",
      "name": "Get waiting messages",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-SITE.example/api/bot/notifications/pending",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      }
    },
    {
      "id": "4fc535f1-82d0-4df4-9d42-d97fcceef95d",
      "name": "One item per message",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        1020,
        220
      ],
      "parameters": {
        "fieldToSplitOut": "notifications",
        "options": {}
      }
    },
    {
      "id": "afdedf1c-835d-4b88-9d2d-d187f8582b90",
      "name": "Send via WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1260,
        220
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.to, type: 'template', template: { name: $json.template, language: { code: $json.language }, components: [{ type: 'body', parameters: $json.body_params.map(t => ({ type: 'text', text: t })) }] } }) }}",
        "options": {}
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "893acb9b-16ff-47bf-a334-a9534f24d464",
      "name": "Tell website: sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        140
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-SITE.example/api/bot/notifications/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('One item per message').item.json.id, ok: true }) }}",
        "options": {}
      }
    },
    {
      "id": "75942d3f-b321-4b50-b624-215c7db35e2b",
      "name": "Tell website: failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1500,
        320
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-SITE.example/api/bot/notifications/ack",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ id: $('One item per message').item.json.id, ok: false, error: String($json.error?.message || 'send failed').slice(0, 400) }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Every minute": {
      "main": [
        [
          {
            "node": "Get waiting messages",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get waiting messages": {
      "main": [
        [
          {
            "node": "One item per message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "One item per message": {
      "main": [
        [
          {
            "node": "Send via WhatsApp",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send via WhatsApp": {
      "main": [
        [
          {
            "node": "Tell website: sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Tell website: failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}