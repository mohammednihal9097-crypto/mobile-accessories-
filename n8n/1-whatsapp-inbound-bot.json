{
  "name": "WhatsApp: customer messages -> store bot",
  "nodes": [
    {
      "id": "830b9942-abc8-4e36-a3da-9a898fa5364d",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -80,
        -40
      ],
      "parameters": {
        "content": "DRAFT - not tested in your n8n yet.\n\n1. Credentials: 'Header Auth' (name x-api-key, value = N8N_INBOUND_SHARED_SECRET) for the Webhook node; 'Header Auth' (name x-api-key, value = N8N_API_SHARED_SECRET) for 'Ask the store bot'; 'Header Auth' (name Authorization, value = Bearer YOUR_WHATSAPP_TOKEN) for 'Send WhatsApp reply'.\n2. Replace YOUR-SITE.example and YOUR_PHONE_NUMBER_ID.\n3. Activate. Then set the Production URL as N8N_INBOUND_WEBHOOK_URL on the website.\n\nAll answers come from the website's database via /api/bot/message. This workflow only moves messages.",
        "width": 560,
        "height": 340
      }
    },
    {
      "id": "fd5d5938-15f5-404e-871a-7bd007e773b5",
      "name": "Verified message from website",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        540,
        200
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "whatsapp-inbound",
        "authentication": "headerAuth",
        "responseMode": "onReceived",
        "options": {}
      },
      "webhookId": "6962a54d-5620-49d4-9395-df4260706030"
    },
    {
      "id": "50082611-8e59-4009-9175-17c27c38fc21",
      "name": "Prepare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        200
      ],
      "parameters": {
        "jsCode": "// Photos, voice notes etc. have no text: send '5' so the bot hands over to a person.\nconst b = $input.first().json.body;\nreturn [{ json: { whatsapp: b.from, name: b.name || '', text: b.unsupported ? '5' : b.text } }];"
      }
    },
    {
      "id": "5e0ced60-bfb3-40c0-8f45-82c2ddec1609",
      "name": "Ask the store bot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://YOUR-SITE.example/api/bot/message",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ whatsapp: $json.whatsapp, name: $json.name, text: $json.text }) }}",
        "options": {
          "timeout": 15000
        }
      }
    },
    {
      "id": "0539a356-7177-4fb5-8fff-6a3ef3d87a02",
      "name": "Send WhatsApp reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1260,
        200
      ],
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v25.0/YOUR_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $('Prepare').item.json.whatsapp, type: 'text', text: { body: $json.reply } }) }}",
        "options": {}
      }
    }
  ],
  "connections": {
    "Verified message from website": {
      "main": [
        [
          {
            "node": "Prepare",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare": {
      "main": [
        [
          {
            "node": "Ask the store bot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask the store bot": {
      "main": [
        [
          {
            "node": "Send WhatsApp reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}