# Placeholder-only example. Copy to .env.local and fill in. NEVER commit real values,
# and never paste them into chat or screenshots. On Vercel, add them under Project > Settings > Environment Variables.

# --- Stage 3: Supabase (Project Settings > API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-sb_publishable-key
# Server-only secret key. No NEXT_PUBLIC_ prefix, ever.
SUPABASE_SECRET_KEY=your-sb_secret-key

# --- Stage 4: signs customer order links and WhatsApp checkout links (random, 32+ characters) ---
ORDER_LINK_SECRET=generate-a-long-random-string
# Your public website address, no trailing slash (used in WhatsApp links)
SITE_URL=http://localhost:3000
# Optional public social profile links
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# --- Stage 5: payments ---
# "placeholder" takes no payments. Set to "razorpay" after finishing docs/stage5-razorpay.md
PAYMENT_PROVIDER=placeholder
# Razorpay API keys (Dashboard > Account & Settings > API Keys). Use rzp_test_ keys first.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# The secret YOU type when creating the webhook in Razorpay (not the API secret)
RAZORPAY_WEBHOOK_SECRET=choose-a-long-random-string

# --- Stage 6: WhatsApp / n8n (details in docs/stage6-whatsapp-n8n.md) ---
# Meta app secret (App settings > Basic) used to verify messages really come from Meta
WHATSAPP_APP_SECRET=from-meta-app-settings
# A random string you invent; you type the same one into Meta when registering the webhook
WHATSAPP_VERIFY_TOKEN=choose-a-random-string
# --- Sending and answering WhatsApp from the website itself (no n8n needed; see docs/whatsapp-without-n8n.md) ---
# The "Phone number ID" from Meta's API Setup page
WHATSAPP_PHONE_NUMBER_ID=paste-your-phone-number-id
# A PERMANENT token from a Meta system user (not the 24-hour test token)
WHATSAPP_ACCESS_TOKEN=paste-your-permanent-token
# Protects the daily safety-net job (random, 16+ characters)
CRON_SECRET=generate-a-long-random-string

# --- Admin order emails (new, paid and cancelled orders go to the addresses in the admin_emails table) ---
# Easiest: send through Gmail. Needs 2-step verification on the account, then myaccount.google.com > Security > App passwords.
GMAIL_USER=triostoreindia@gmail.com
GMAIL_APP_PASSWORD=paste-your-16-character-app-password
# Alternative to Gmail. From resend.com > API Keys. Sign up with triostoreindia@gmail.com; Resend's test sender only delivers to that address.
RESEND_API_KEY=paste-your-resend-api-key
# Optional. Only set after verifying your own domain in Resend, e.g. Trio Store <orders@yourdomain.com>
EMAIL_FROM=

# --- Only if you use n8n (optional) ---
# Secret n8n sends in the x-api-key header when calling this site's /api/bot/* endpoints
N8N_API_SHARED_SECRET=generate-a-long-random-string
# Where this site forwards verified WhatsApp messages, and the secret n8n expects with them
N8N_INBOUND_WEBHOOK_URL=https://your-n8n-host/webhook/whatsapp-inbound
N8N_INBOUND_SHARED_SECRET=generate-another-long-random-string

# --- Stage 7: Sarvam languages (OFF until BOTH are filled in) ---
SARVAM_API_KEY=your-sarvam-api-key
# Language codes you choose, e.g. hi-IN,ta-IN  (supported list in docs/stage7-sarvam.md)
SARVAM_LANGUAGES=
